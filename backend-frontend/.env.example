# Copy to .env (never commit .env). Docker Compose reads it automatically.
POSTGRES_DB=kuairec
POSTGRES_USER=kuairec
POSTGRES_PASSWORD=replace_with_a_private_local_password

# Host ports
API_PORT=8080
WEB_PORT=3000

# Go API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=300
# Optional: when set, POST /api/v1/models/switch requires header X-Admin-Token.
ADMIN_TOKEN=
LOG_LEVEL=info

# Local development without Docker (run from backend/):
#   DATABASE_URL=postgres://kuairec:<password>@localhost:5432/kuairec?sslmode=disable
#   DATA_DIR=./serving_data
# Frontend (run from frontend/): API_INTERNAL_URL=http://127.0.0.1:8080 (used at build/dev time)
