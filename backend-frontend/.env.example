# Copy this file to .env before running Docker Compose. Use a private password.
POSTGRES_DB=kuairec
POSTGRES_USER=kuairec
POSTGRES_PASSWORD=replace_with_a_private_local_password
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend Configuration
PORT=8080
DATA_DIR=./serving_data
DATABASE_URL=postgres://kuairec:replace_with_a_private_local_password@localhost:5432/kuairec?sslmode=disable
DEFAULT_TOP_K=10

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
API_INTERNAL_URL=http://backend:8080
